def partition(a, x):
    e, g, n = 0, 0, 0

    while n < len(a):
        if a[n] > x:
            n += 1
        elif a[n] == x:
            a[g], a[n] = a[n], a[g]
            g += 1
            n += 1
        else:
            temp = a[n]
            a[n] = a[g]
            a[g] = a[e]
            a[e] = temp
            e += 1
            g += 1
            n += 1
    
    return e


n = int(input())
arr = list(map(int, input().split()))
x = int(input())

p = partition(arr, x)
print(p)
print(len(arr) - p)
