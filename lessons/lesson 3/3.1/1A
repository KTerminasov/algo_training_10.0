def partition(a, x, left=0, r=0):
    e, g, n = 0, 0, left

    while n < r:
        if a[n] > x:
            n += 1
        elif a[n] == x:
            a[g], a[n] = a[n], a[g]
            g += 1
            n += 1
        else:
            temp = a[n]
            a[n] = a[g]
            a[g] = a[e]
            a[e] = temp
            e += 1
            g += 1
            n += 1
    
    return e


n = int(input())
arr = list(map(int, input().split()))
x = int(input())

p = partition(arr, x, 0, n)
print(p)
print(n - p)
